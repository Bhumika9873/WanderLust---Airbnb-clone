<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-5 col-md-7">

            <div class="glass-card p-5">

                <div class="text-center mb-5">

                    <div class="mb-3">
                        <i class="fa-solid fa-compass fa-3x text-success"></i>
                    </div>

                    <h1 class="fw-bold">
                        Welcome Back
                    </h1>

                    <p class="text-muted">
                        Login to continue your journey with WanderStay.
                    </p>

                </div>

                <form
                    action="/login"
                    method="POST"
                    class="needs-validation"
                    novalidate>

                    <!-- Username -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">

                            <i class="fa-solid fa-user text-success"></i>

                            Username

                        </label>

                        <input
                            id="username"
                            name="username"
                            type="text"
                            class="form-control"
                            placeholder="Enter your username"
                            required>

                    </div>

                    <!-- Password -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">

                            <i class="fa-solid fa-lock text-success"></i>

                            Password

                        </label>

                        <input
                            id="password"
                            name="password"
                            type="password"
                            class="form-control"
                            placeholder="Enter your password"
                            required>

                    </div>

                    <button
                        class="btn btn-success w-100 py-3 rounded-4 fw-bold">

                        <i class="fa-solid fa-right-to-bracket"></i>

                        Login

                    </button>

                </form>

                <hr class="my-4">

                <p class="text-center text-muted mb-0">

                    Don't have an account?

                    <a
                        href="/signup"
                        class="text-success text-decoration-none fw-bold">

                        Create One

                    </a>

                </p>

            </div>

        </div>

    </div>

</div>