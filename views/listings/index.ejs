<% layout("/layouts/boilerplate") %>

<!-- ================= HERO SECTION ================= -->

<section class="hero fade-up">

    <div class="hero-content">

        <span class="badge-green">
            🌍 Explore • Stay • Travel
        </span>

        <h1 class="mt-4">
            Find Your Perfect <br>
            Place To Stay
        </h1>

        <p class="mt-3">
            Discover luxury villas, mountain cabins, beach houses and unique
            stays around the world.
        </p>

        <a href="#listings" class="primary-btn text-decoration-none mt-4 d-inline-block">
            Explore Now
        </a>

    </div>

</section>

<!-- ================= POPULAR STAYS ================= -->

<section id="listings" class="mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">

        <div>

            <h2 class="section-title text-start mb-1">
                Popular Stays
            </h2>

            <p class="text-muted">
                Handpicked destinations just for you.
            </p>

        </div>

    </div>

    <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">

        <% for(let listing of allListings){ %>

        <div class="col">

            <a href="/listings/<%= listing._id %>" class="listing-link">

                <div class="card listing-card shadow-hover fade-up">

                    <div class="position-relative zoom">

                        <img
                            src="<%= listing.image.url %>"
                            class="card-img-top"
                            alt="listing_image">

                        <div class="card-img-overlay"></div>

                        <!-- Wishlist -->

                        <button
                            class="btn position-absolute top-0 end-0 m-3 bg-white rounded-circle shadow"
                            style="width:45px;height:45px;">

                            <i class="fa-regular fa-heart text-danger"></i>

                        </button>

                        <!-- Category -->

                        <% if(listing.category){ %>

                        <span
                            class="badge bg-success position-absolute bottom-0 start-0 m-3 px-3 py-2 rounded-pill">

                            <%= listing.category %>

                        </span>

                        <% } %>

                    </div>

                    <div class="card-body">

                        <h5 class="card-title mb-1">
                            <%= listing.title %>
                        </h5>

                        <p class="text-muted mb-2">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= listing.location %>
                        </p>

                        <div class="d-flex justify-content-between align-items-center mt-3">

                            <div>

                                <span class="price">
                                    ₹ <%= listing.price.toLocaleString("en-IN") %>
                                </span>

                                <small class="text-muted">
                                    / night
                                </small>

                                <div class="tax-info text-success">
                                    +18% GST
                                </div>

                            </div>

                            <button class="primary-btn">
                                View
                            </button>

                        </div>

                    </div>

                </div>

            </a>

        </div>

        <% } %>

    </div>

</section>

<script>

const taxSwitch = document.getElementById("flexSwitchCheckDefault");

taxSwitch.addEventListener("click", () => {

    const taxInfo = document.querySelectorAll(".tax-info");

    taxInfo.forEach(info => {

        if(info.style.display === "inline"){

            info.style.display = "none";

        }else{

            info.style.display = "inline";

        }

    });

});

</script>

