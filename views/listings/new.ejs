<% layout("layouts/boilerplate") %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="glass-card p-5">

                <div class="text-center mb-5">

                    <span class="badge bg-success px-3 py-2 rounded-pill">
                        Create Listing
                    </span>

                    <h1 class="fw-bold mt-3">
                        List Your Dream Property
                    </h1>

                    <p class="text-muted">
                        Share your amazing place with travellers around the world.
                    </p>

                </div>

                <form
                    method="POST"
                    action="/listings"
                    novalidate
                    class="needs-validation"
                    enctype="multipart/form-data">

                    <!-- Title -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-heading text-success"></i>
                            Property Title
                        </label>

                        <input
                            name="listing[title]"
                            type="text"
                            class="form-control"
                            placeholder="Luxury Villa with Pool"
                            required>

                        <div class="valid-feedback">
                            Looks Great!
                        </div>

                    </div>

                    <!-- Description -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-align-left text-success"></i>
                            Description
                        </label>

                        <textarea
                            name="listing[description]"
                            class="form-control"
                            rows="5"
                            placeholder="Tell guests what makes your place special..."
                            required></textarea>

                        <div class="invalid-feedback">
                            Please enter a description.
                        </div>

                    </div>

                    <!-- Image -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-image text-success"></i>
                            Upload Image
                        </label>

                        <input
                            type="file"
                            class="form-control"
                            name="listing[image]"
                            required>

                    </div>

                    <div class="row">

                        <!-- Price -->

                        <div class="col-md-4 mb-4">

                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-indian-rupee-sign text-success"></i>
                                Price
                            </label>

                            <input
                                name="listing[price]"
                                class="form-control"
                                placeholder="2500"
                                required>

                            <div class="invalid-feedback">
                                Enter a valid price.
                            </div>

                        </div>

                        <!-- Country -->

                        <div class="col-md-8 mb-4">

                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-earth-americas text-success"></i>
                                Country
                            </label>

                            <input
                                type="text"
                                name="listing[country]"
                                class="form-control"
                                placeholder="India"
                                required>

                            <div class="invalid-feedback">
                                Enter a country.
                            </div>

                        </div>

                    </div>

                    <!-- Location -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-location-dot text-success"></i>
                            Location
                        </label>

                        <input
                            type="text"
                            name="listing[location]"
                            class="form-control"
                            placeholder="Jaipur, Rajasthan"
                            required>

                        <div class="invalid-feedback">
                            Enter a location.
                        </div>

                    </div>

                    <!-- Category -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-layer-group text-success"></i>
                            Category
                        </label>

                        <select
                            name="listing[category]"
                            class="form-select"
                            required>

                            <option value="">Choose Category</option>

                            <option value="Trending">Trending</option>
                            <option value="Rooms">Rooms</option>
                            <option value="Iconic cities">Iconic Cities</option>
                            <option value="Mountains">Mountains</option>
                            <option value="Castles">Castles</option>
                            <option value="Amazing pools">Amazing Pools</option>
                            <option value="Camping">Camping</option>
                            <option value="Farms">Farms</option>
                            <option value="Arctic pool">Arctic Pool</option>
                            <option value="Domes">Domes</option>

                        </select>

                    </div>

                    <!-- Buttons -->

                    <div class="d-flex justify-content-end gap-3 mt-5">

                        <a
                            href="/listings"
                            class="btn btn-outline-secondary px-4 rounded-4">

                            Cancel

                        </a>

                        <button
                            class="btn btn-success px-5 rounded-4 fw-bold">

                            <i class="fa-solid fa-plus"></i>

                            Publish Listing

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>