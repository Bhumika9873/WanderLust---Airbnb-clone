<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="glass-card p-5">

                <div class="text-center mb-5">

                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                        Edit Listing
                    </span>

                    <h1 class="fw-bold mt-3">
                        Update Your Property
                    </h1>

                    <p class="text-muted">
                        Keep your listing fresh and attractive for travellers.
                    </p>

                </div>

                <form
                    method="POST"
                    action="/listings/<%= listing._id %>?_method=PUT"
                    novalidate
                    class="needs-validation"
                    enctype="multipart/form-data">

                    <!-- Title -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-heading text-success"></i>
                            Property Title
                        </label>

                        <input
                            type="text"
                            name="listing[title]"
                            value="<%= listing.title %>"
                            class="form-control"
                            required>

                        <div class="valid-feedback">
                            Looks Great!
                        </div>

                    </div>

                    <!-- Description -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-align-left text-success"></i>
                            Description
                        </label>

                        <textarea
                            name="listing[description]"
                            rows="5"
                            class="form-control"
                            required><%= listing.description %></textarea>

                        <div class="invalid-feedback">
                            Please enter a description.
                        </div>

                    </div>

                    <!-- Current Image -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            Current Image
                        </label>

                        <div class="text-center">

                            <img
                                src="<%= originalImageUrl %>"
                                class="img-fluid rounded-4 shadow"
                                style="max-height:280px; object-fit:cover;">

                        </div>

                    </div>

                    <!-- Upload -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-image text-success"></i>
                            Upload New Image
                        </label>

                        <input
                            type="file"
                            class="form-control"
                            name="listing[image]">

                    </div>

                    <div class="row">

                        <!-- Price -->

                        <div class="col-md-4 mb-4">

                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-indian-rupee-sign text-success"></i>
                                Price
                            </label>

                            <input
                                type="number"
                                class="form-control"
                                name="listing[price]"
                                value="<%= listing.price %>"
                                required>

                        </div>

                        <!-- Country -->

                        <div class="col-md-8 mb-4">

                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-earth-americas text-success"></i>
                                Country
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                name="listing[country]"
                                value="<%= listing.country %>"
                                required>

                        </div>

                    </div>

                    <!-- Location -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-location-dot text-success"></i>
                            Location
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            name="listing[location]"
                            value="<%= listing.location %>"
                            required>

                    </div>

                    <!-- Category -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-layer-group text-success"></i>
                            Category
                        </label>

                        <select
                            name="listing[category]"
                            class="form-select"
                            required>

                            <option value="Trending" <%= listing.category==="Trending"?"selected":"" %>>Trending</option>

                            <option value="Rooms" <%= listing.category==="Rooms"?"selected":"" %>>Rooms</option>

                            <option value="Iconic cities" <%= listing.category==="Iconic cities"?"selected":"" %>>Iconic Cities</option>

                            <option value="Mountains" <%= listing.category==="Mountains"?"selected":"" %>>Mountains</option>

                            <option value="Castles" <%= listing.category==="Castles"?"selected":"" %>>Castles</option>

                            <option value="Amazing pools" <%= listing.category==="Amazing pools"?"selected":"" %>>Amazing Pools</option>

                            <option value="Camping" <%= listing.category==="Camping"?"selected":"" %>>Camping</option>

                            <option value="Farms" <%= listing.category==="Farms"?"selected":"" %>>Farms</option>

                            <option value="Arctic pool" <%= listing.category==="Arctic pool"?"selected":"" %>>Arctic Pool</option>

                            <option value="Domes" <%= listing.category==="Domes"?"selected":"" %>>Domes</option>

                        </select>

                    </div>

                    <!-- Buttons -->

                    <div class="d-flex justify-content-end gap-3 mt-5">

                        <a
                            href="/listings/<%= listing._id %>"
                            class="btn btn-outline-secondary px-4 rounded-4">

                            Cancel

                        </a>

                        <button
                            class="btn btn-warning px-5 rounded-4 fw-bold">

                            <i class="fa-solid fa-floppy-disk"></i>

                            Save Changes

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>