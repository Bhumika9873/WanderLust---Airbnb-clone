<% layout("/layouts/boilerplate") %>

<script>
const mapToken = "<%= process.env.MAP_TOKEN %>";
const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="container py-4">

    <!-- Hero Image -->

    <div class="hero-listing mb-4">

        <img
            src="<%= listing.image.url %>"
            class="hero-img"
            alt="listing image">

        <div class="hero-overlay"></div>

        <div class="hero-content">

            <span class="badge rounded-pill bg-success px-3 py-2">

                <%= listing.category || "Stay" %>

            </span>

            <h1 class="mt-3 fw-bold">

                <%= listing.title %>

            </h1>

            <p class="text-light fs-5">

                <i class="fa-solid fa-location-dot"></i>

                <%= listing.location %>, <%= listing.country %>

            </p>

        </div>

    </div>

    <!-- Details -->

    <div class="row g-4">

        <!-- LEFT -->

        <div class="col-lg-8">

            <div class="glass-card p-4">

                <div class="d-flex justify-content-between align-items-center flex-wrap">

                    <div>

                        <h3 class="fw-bold mb-2">

                            Hosted by
                            <%= listing.owner && listing.owner.username ? listing.owner.username : "Unknown User" %>

                        </h3>

                        <p class="text-muted">

                            Verified Host • Super Experience

                        </p>

                    </div>

                    <div>

                        <span class="badge bg-warning text-dark rounded-pill fs-6">

                            ⭐ 4.9

                        </span>

                    </div>

                </div>

                <hr>

                <h5>Description</h5>

                <p class="text-muted">

                    <%= listing.description %>

                </p>

            </div>

        </div>

        <!-- RIGHT -->

        <div class="col-lg-4">

            <div class="booking-card shadow-lg">

                <h2 class="fw-bold">

                    ₹ <%= listing.price.toLocaleString("en-IN") %>

                    <small class="text-muted fs-6">/ night</small>

                </h2>

                <hr>

                <a
                href="/book/<%= listing._id %>"
                class="btn btn-success w-100 py-3 rounded-4 fw-bold">
                Reserve Now
                </a>

                <form action="/wishlist/<%= listing._id %>" method="POST">
                    <button class="btn btn-outline-dark w-100 mt-3 rounded-4 fw-bold">
                        Save Listing
                    </button>
                </form>

            </div>

        </div>

    </div>

    <!-- Amenities -->

    <div class="glass-card p-4 mt-4">

        <h3 class="mb-4">

            What this place offers

        </h3>

        <div class="row g-3">

            <div class="col-md-3">
                <i class="fa-solid fa-wifi text-success"></i> Free WiFi
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-square-parking text-success"></i> Parking
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-person-swimming text-success"></i> Pool
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-snowflake text-success"></i> AC
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-tv text-success"></i> Smart TV
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-kitchen-set text-success"></i> Kitchen
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-paw text-success"></i> Pet Friendly
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-dumbbell text-success"></i> Gym
            </div>

        </div>

    </div>

        <!-- Owner Actions -->

    <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>

    <div class="d-flex gap-3 mt-4">

        <a
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-warning px-4">

            <i class="fa-solid fa-pen"></i>
            Edit Listing

        </a>

        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE">

            <button class="btn btn-danger px-4">

                <i class="fa-solid fa-trash"></i>
                Delete

            </button>

        </form>

    </div>

    <% } %>

    <!-- Review Form -->

    <% if(currUser){ %>

    <div class="glass-card p-4 mt-5">

        <h3 class="mb-4">

            Leave a Review

        </h3>

        <form
            action="/listings/<%= listing.id %>/reviews"
            method="POST"
            novalidate
            class="needs-validation">

            <div class="mb-4">

                <label class="form-label">

                    Rating

                </label>

                <fieldset class="starability-slot">

                    <input
                        type="radio"
                        id="no-rate"
                        class="input-no-rate"
                        name="review[rating]"
                        value="1"
                        checked>

                    <input type="radio" id="first-rate1" name="review[rating]" value="1">
                    <label for="first-rate1">1 star</label>

                    <input type="radio" id="first-rate2" name="review[rating]" value="2">
                    <label for="first-rate2">2 stars</label>

                    <input type="radio" id="first-rate3" name="review[rating]" value="3">
                    <label for="first-rate3">3 stars</label>

                    <input type="radio" id="first-rate4" name="review[rating]" value="4">
                    <label for="first-rate4">4 stars</label>

                    <input type="radio" id="first-rate5" name="review[rating]" value="5">
                    <label for="first-rate5">5 stars</label>

                </fieldset>

            </div>

            <div class="mb-4">

                <label class="form-label">

                    Your Experience

                </label>

                <textarea
                    class="form-control"
                    rows="5"
                    name="review[comment]"
                    required
                    placeholder="Share your experience..."></textarea>

                <div class="invalid-feedback">

                    Please write a review.

                </div>

            </div>

            <button class="btn btn-success px-5">

                Submit Review

            </button>

        </form>

    </div>

    <% } %>

    <!-- Reviews -->

    <% if(listing.reviews.length > 0){ %>

    <div class="mt-5">

        <h3 class="mb-4">

            Guest Reviews

        </h3>

        <div class="row g-4">

            <% for(review of listing.reviews){ %>

            <div class="col-md-6">

                <div class="glass-card p-4 h-100">

                    <div class="d-flex justify-content-between">

                        <h5>

                            @<%= review.author && review.author.username ? review.author.username : "Unknown User" %>

                        </h5>

                        <span class="badge bg-warning text-dark">

                            ⭐ <%= review.rating %>

                        </span>

                    </div>

                    <p class="mt-3 text-muted">

                        <%= review.comment %>

                    </p>

                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">

                        <button class="btn btn-outline-danger btn-sm">

                            Delete Review

                        </button>

                    </form>

                </div>

            </div>

            <% } %>

        </div>

    </div>

    <% } %>

        <!-- Map Section -->

    <% if(listing.geometry && listing.geometry.coordinates.length === 2){ %>

    <div class="glass-card p-4 mt-5">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h3 class="mb-0">

                <i class="fa-solid fa-location-dot text-success"></i>

                Where You'll Be

            </h3>

            <span class="badge bg-success">

                Interactive Map

            </span>

        </div>

        <div id="map" class="rounded-4 overflow-hidden"></div>

    </div>

    <script src="/js/map.js"></script>

    <% } %>

    <!-- Nearby -->

    <div class="glass-card p-4 mt-5">

        <h3 class="mb-4">

            Nearby Highlights

        </h3>

        <div class="row text-center g-4">

            <div class="col-md-3">

                <i class="fa-solid fa-utensils fa-2x text-success mb-3"></i>

                <h6>Restaurants</h6>

                <p class="text-muted mb-0">

                    Top rated dining nearby.

                </p>

            </div>

            <div class="col-md-3">

                <i class="fa-solid fa-cart-shopping fa-2x text-success mb-3"></i>

                <h6>Shopping</h6>

                <p class="text-muted mb-0">

                    Popular shopping streets.

                </p>

            </div>

            <div class="col-md-3">

                <i class="fa-solid fa-tree-city fa-2x text-success mb-3"></i>

                <h6>Parks</h6>

                <p class="text-muted mb-0">

                    Beautiful nature nearby.

                </p>

            </div>

            <div class="col-md-3">

                <i class="fa-solid fa-camera-retro fa-2x text-success mb-3"></i>

                <h6>Attractions</h6>

                <p class="text-muted mb-0">

                    Must-visit tourist spots.

                </p>

            </div>

        </div>

    </div>

    <!-- Booking Tips -->

    <div class="glass-card p-4 mt-5 mb-5">

        <h3>

            Travel Tips

        </h3>

        <ul class="mt-3">

            <li>✔ Free cancellation may be available for selected stays.</li>

            <li>✔ Contact the host for special requests before booking.</li>

            <li>✔ Carry a valid government ID during check-in.</li>

            <li>✔ Respect house rules and nearby residents.</li>

        </ul>

    </div>

</div>